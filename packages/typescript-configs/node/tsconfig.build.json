{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node Build",
  "include": ["${configDir}/src/**/*"],
  "exclude": ["${configDir}/src/**/*.test.ts", "${configDir}/src/**/*.test.tsx", "${configDir}/src/**/__generated__/**/*"],
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
