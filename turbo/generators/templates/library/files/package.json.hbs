{
  "name": "@example/{{ name }}",
  "version": "1.0.0",
  "private": true,
  "type": "module",
{{#if compiled}}
  "imports": {
    "#*": {
      "development": [
        "./src/*",
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "default": "./dist/*.js"
    }
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
{{else}}
  "imports": {
    "#*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx",
      "./src/*/index.ts",
      "./src/*/index.tsx"
    ]
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
{{/if}}
  "scripts": {
{{#if compiled}}
    "build": "labuild build",
{{/if}}
    "check": "labuild check",
    "test": "labuild test"
  },
{{#if frontend}}
  "devDependencies": {
    "@example/labuild": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  }
{{else}}
  "devDependencies": {
    "@example/labuild": "workspace:*",
    "@types/node": "catalog:",
    "vitest": "catalog:"
  }
{{/if}}
}
