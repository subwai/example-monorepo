import { ApolloFederationDriver, type ApolloFederationDriverConfig } from '@nestjs/apollo';
import { Module } from '@nestjs/common';
import { GraphQLModule } from '@nestjs/graphql';

import { FederationTestResolver } from '#graphql/federation-test/federation-test.resolver';
import { schemaPath } from '#graphql/schema-path';

@Module({
  imports: [
    GraphQLModule.forRoot<ApolloFederationDriverConfig>({
      driver: ApolloFederationDriver,
      autoSchemaFile: { federation: 2, path: schemaPath() },
      sortSchema: true,
    }),
  ],
  providers: [FederationTestResolver],
})
export class GraphqlModule {}
